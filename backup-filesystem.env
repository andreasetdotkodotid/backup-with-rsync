# ==========================================================
# Rsync Filesystem Backup Configuration
# ==========================================================

# Authentication
export RSYNC_PASSWORD="PASSWORD"

# Backup Servers
export BACKUP_HOST_MEDAN="IP-BACKUP-MEDAN"
export BACKUP_HOST_JAKARTA="IP-BACKUP-JAKARTA"

# Backup User
# Kosongkan agar otomatis menggunakan hostname -f
export BACKUP_USER=""

# Timeout
export BACKUP_TIMEOUT=300
export BACKUP_CONNECT_TIMEOUT=60

# Lock File
export BACKUP_LOCK_FILE="/var/lock/rsync-fullbackup.lock"

# ==========================================================
# Monitoring
# ==========================================================

export METRICS_URL="METRIC_ENDPOINT"
export METRICS_AUTH="Basic xxxxxxxxxxxxxxxxx"

# Hostname label
# kosong = hostname -f
export METRIC_HOST=""

# Backup schedule label
export BACKUP_SCHEDULE="3x_week"

# Metric type
export BACKUP_TYPE="filesystem"
